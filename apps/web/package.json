{
  "name": "@helixa/multipass-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build && node scripts/write-allowlist-entry.mjs && node scripts/build-looper-marketplace-previews.mjs && node scripts/build-activate-looper-3802.mjs --dist && node scripts/build-looper-multipass-profiles.mjs --dist",
    "build:activate-looper-3802": "node scripts/build-activate-looper-3802.mjs",
    "build:looper-multipass-profile": "node scripts/build-looper-multipass-profiles.mjs",
    "check:activate-looper-3802": "node scripts/build-activate-looper-3802.mjs --check && node scripts/scan-activate-looper-3802.mjs",
    "smoke:activate-looper-3802-no-wallet": "CHROMIUM_PATH=/snap/bin/chromium node scripts/smoke-activate-looper-3802-no-wallet.mjs",
    "generate:allowlist-preview": "node scripts/render-allowlist-preview.mjs",
    "smoke:looper-mint-browser": "CHROMIUM_PATH=/snap/bin/chromium node scripts/smoke-looper-mint-browser.mjs",
    "capture:sibyl-console-demo": "CHROMIUM_PATH=/snap/bin/chromium node scripts/capture-sibyl-console-demo.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test test/*.test.mjs",
    "smoke:restap-network-console": "CHROMIUM_PATH=/snap/bin/chromium node --test test/console-restap-network-browser.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright-core": "^1.61.1",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.37.0",
    "@xmtp/browser-sdk": "6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.53.1"
  }
}
