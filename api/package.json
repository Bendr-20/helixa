{
  "name": "@helixa/agentdna-api",
  "version": "1.0.0",
  "description": "Helixa identity, discovery, Cred, and x402 API on Base",
  "type": "commonjs",
  "main": "v2-server.js",
  "scripts": {
    "start": "node v2-server.js",
    "dev": "node --watch v2-server.js",
    "audit:internal-auth": "node scripts/audit-internal-auth.js",
    "test:internal-auth": "node scripts/test-internal-auth.js",
    "test:cred-shadow": "node --test test/cred-shadow/*.test.js",
    "test:cred-evidence": "node --test test/cred-evidence/*.test.js",
    "cred:shadow:replay": "node scripts/run-cred-shadow-replay.js",
    "cred:evidence:compile": "node scripts/compile-cred-evidence.js",
    "test:cred-looper": "node --test test/cred-looper/*.test.js",
    "cred:looper:collect": "node scripts/collect-looper-base-proofs.js",
    "cred:looper:build": "node scripts/build-looper-cred-corpus.js",
    "test:cred-afg": "node --test test/cred-afg/*.test.js",
    "cred:afg:collect": "node scripts/collect-looper-afg.js",
    "cred:afg:verify": "node scripts/verify-afg-statement.js",
    "cred:afg:build": "node scripts/build-looper-afg-shadow.js",
    "test:cred-payments": "node --test test/cred-payments/*.test.js",
    "cred:payments:collect": "node scripts/collect-looper-payments.js",
    "cred:payments:build": "node scripts/build-looper-payment-observer.js",
    "cred:payments:bootstrap": "node scripts/launch-looper-payment-operation.js bootstrap",
    "cred:payments:validate": "node scripts/launch-looper-payment-operation.js validate",
    "cred:payments:follow-up": "node scripts/launch-looper-payment-operation.js follow-up",
    "cred:payments:recover": "node scripts/launch-looper-payment-operation.js recover",
    "cred:payments:shadow": "node scripts/launch-looper-payment-operation.js shadow",
    "cred:payments:cron:install": "node scripts/launch-looper-payment-operation.js cron-install",
    "cred:payments:cron:remove": "node scripts/launch-looper-payment-operation.js cron-remove",
    "cred:payments:cron:preview": "node scripts/manage-looper-payment-cron.js preview",
    "cred:payments:review": "node scripts/launch-looper-payment-operation.js review",
    "cred:payments:archive": "node scripts/launch-looper-payment-operation.js archive",
    "test:cred-looper-live": "node --test test/cred-looper-live/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.77.0",
    "@aws-sdk/client-secrets-manager": "^3.997.0",
    "@dexterai/x402": "^1.7.0",
    "@metaplex-foundation/mpl-bubblegum": "^5.0.2",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@metaplex-foundation/umi-web3js-adapters": "^1.5.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@opensea/tool-sdk": "^0.27.0",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.5.0",
    "@x402/evm": "^2.8.0",
    "@x402/express": "^2.5.0",
    "@x402/fetch": "^2.8.0",
    "agentmail": "^0.3.7",
    "better-sqlite3": "^12.6.2",
    "bs58": "^6.0.0",
    "ethers": "^6.13.0",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "mppx": "^0.4.8",
    "ox": "^0.13.0",
    "tweetnacl": "^1.0.3"
  },
  "bin": {
    "cred-shadow-replay": "scripts/run-cred-shadow-replay.js",
    "cred-evidence-compile": "scripts/compile-cred-evidence.js",
    "cred-looper-collect": "scripts/collect-looper-base-proofs.js",
    "cred-looper-build": "scripts/build-looper-cred-corpus.js",
    "cred-afg-collect": "scripts/collect-looper-afg.js",
    "cred-afg-verify": "scripts/verify-afg-statement.js",
    "cred-afg-build": "scripts/build-looper-afg-shadow.js",
    "cred-payments-collect": "scripts/collect-looper-payments.js",
    "cred-payments-build": "scripts/build-looper-payment-observer.js"
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4"
  }
}
